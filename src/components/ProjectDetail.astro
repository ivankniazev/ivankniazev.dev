---
import LedgerRow from './LedgerRow.astro';
import { useTranslations, getLocalizedPath, type Lang } from '../utils/i18n';
import { projects, progressOf, statusOf, stepState } from '../utils/projects';

interface Props {
  project: any;
  lang: Lang;
}

const { project, lang } = Astro.props;
const t = useTranslations(lang);
const status = statusOf(project);
const { done, total, steps } = progressOf(project);
const index = projects.findIndex((p: any) => p.slug === project.slug);
const onward = [1, 2, 3].map((k) => projects[(index + k) % projects.length]);
const links = project.links || {};
const site = links.website || links.download || links.github;
---

<article class="accent" style={`--accent-h: ${project.accentHue}`}>
  <header class:list={['cover', { 'cover--shot': project.image }]}>
    <div class="cover__inner shell">
      <div class="cover__top">
        <span class="meta">{project.domain[lang]}</span>
        <span class="meta">
          {project.year} · {t(`projects.status.${status}`)} · {done}/{total}
        </span>
      </div>
      <h1 class="display">{project.title[lang]}</h1>
      <p class="cover__text">{project.shortDescription[lang]}</p>
      <div class="cover__foot">
        <ul class="tags">
          {project.techStack.slice(0, 5).map((tech: string) => <li class="tag">{tech}</li>)}
        </ul>
        {site && (
          <a href={site} class="cover__cta" target="_blank" rel="noopener">
            {links.website ? links.website.replace(/^https?:\/\//, '') : t('projects.labels.download')} →
          </a>
        )}
      </div>
    </div>
    {project.image && (
      <div class="cover__shot" style={`--shot-w: ${project.imageWidth}px`}>
        <img
          src={project.image}
          alt={project.title[lang]}
          width={project.imageWidth}
          height={project.imageHeight}
          decoding="async"
        />
      </div>
    )}
  </header>

  <div class="detail__intro shell">
    <div>
      <p class="meta">{t('projects.labels.overview')}</p>
      <p class="prose">{project.overview[lang]}</p>
    </div>

    {project.useCases && (
      <div class="aside-tint">
        <p class="meta">{t('projects.labels.useCases')}</p>
        <ul class="use-cases">
          {project.useCases.map((u: any) => (
            <li class="row">
              <span><strong>{u.title[lang]}</strong><span>{u.description[lang]}</span></span>
            </li>
          ))}
        </ul>
      </div>
    )}
  </div>

  <section class="section shell">
    <div class="section__head section__head--strong">
      <h2 class="head">{t('projects.labels.features')}</h2>
      <span class="rule" aria-hidden="true"></span>
      <span class="meta">{String(project.features.length).padStart(2, '0')}</span>
    </div>
    <dl class="features">
      {project.features.map((f: any, i: number) => (
        <div class="feature">
          <dt><span class="feature__n">{String(i + 1).padStart(2, '0')}</span>{f.title[lang]}</dt>
          <dd>{f.description[lang]}</dd>
        </div>
      ))}
    </dl>
  </section>

  <div class="detail__cols shell">
    {project.pricing && (
      <section>
        <div class="section__head section__head--strong">
          <h2 class="head">{t('projects.labels.pricing')}</h2>
          <span class="rule" aria-hidden="true"></span>
        </div>
        <div class="pricing">
          <div class="plan">
            <span class="meta">{t('projects.labels.free')}</span>
            <span class="plan__price">{project.pricing.free.price[lang]} <small>{project.pricing.free.period[lang]}</small></span>
            <ul>{project.pricing.free.features.map((f: any) => <li>{f[lang]}</li>)}</ul>
          </div>
          <div class="plan plan--premium">
            <span class="meta">{t('projects.labels.premium')}</span>
            <span class="plan__price">{project.pricing.premium.price[lang]} <small>{project.pricing.premium.period[lang]}</small></span>
            <ul>{project.pricing.premium.features.map((f: any) => <li>{f[lang]}</li>)}</ul>
          </div>
        </div>
      </section>
    )}

    <section class="steps">
      <div class="section__head section__head--strong">
        <h2 class="head">{t('projects.labels.timeline')}</h2>
        <span class="rule" aria-hidden="true"></span>
        <span class="meta num">{done}/{total}</span>
      </div>
      <div class="track" role="img" aria-label={`${done}/${total}`} style="height: 8px; margin-bottom: var(--s-4)">
        {steps.map((s: any) => {
          const st = stepState(s);
          return <span class:list={[{ 'is-progress': st === 'in-progress', 'is-pending': st === 'pending' }]} style="height: 8px"></span>;
        })}
      </div>
      <ol>
        {steps.map((s: any, i: number) => (
          <li class:list={['row', `is-${stepState(s)}`]}>
            <span class="steps__n">{String(i + 1).padStart(2, '0')}</span>
            <span>
              <span class="steps__title">{s.title[lang]}</span>
              <span class="steps__text">{s.description[lang]}</span>
            </span>
          </li>
        ))}
      </ol>
    </section>
  </div>

  <section class="onward shell" aria-label={t('projects.onward')}>
    <div class="onward__head">
      <span class="meta">{t('projects.onward')}</span>
      <span class="rule" aria-hidden="true"></span>
      <a href={getLocalizedPath('/projects', lang)} class="meta">{t('home.allNine')} →</a>
    </div>
    {onward.map((p: any) => <LedgerRow project={p} lang={lang} variant="ledger" />)}
  </section>
</article>
