---
import { useTranslations, getLocalizedPath, type Lang } from '../utils/i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="footer-inner">
    <p class="footer-copy">© {year} {lang === 'en' ? 'Ivan Kniazev' : 'Иван Князев'}</p>
    <div class="footer-links">
      <a href="mailto:contact@ivankniazev.dev">contact@ivankniazev.dev</a>
      <a href="https://www.threads.com/@darkersigner" rel="me noopener" target="_blank">Threads</a>
      <a href={getLocalizedPath('/terms', lang)}>{t('footer.terms')}</a>
      <a href={getLocalizedPath('/privacy', lang)}>{t('footer.privacy')}</a>
      <a href={getLocalizedPath('/refund', lang)}>{t('footer.refund')}</a>
    </div>
  </div>
</footer>
