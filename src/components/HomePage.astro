---
import LedgerRow from './LedgerRow.astro';
import { useTranslations, getLocalizedPath, type Lang } from '../utils/i18n';
import { projects, slides, totals, progressOf, statusOf } from '../utils/projects';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const cover = slides();
const n = totals();
---

<section class="slider" aria-label={t('home.featuredTitle')}>
  <div class="slider__track" id="slides">
    {cover.map((p: any, i: number) => {
      const { done, total } = progressOf(p);
      const status = statusOf(p);
      return (
        <a
          class:list={['slide', 'accent', { 'slide--shot': p.image }]}
          id={`slide-${i + 1}`}
          href={getLocalizedPath(`/projects/${p.slug}`, lang)}
          style={`--accent-h: ${p.accentHue}`}
        >
          <span class="slide__body">
          <span class="slide__top">
            <span class="meta">{String(i + 1).padStart(2, '0')} — {p.domain[lang]}</span>
            <span class="meta">
              {p.year} · {t(`projects.status.${status}`)} · {done}/{total}
            </span>
          </span>
          <span>
            <span class="slide__name">{p.title[lang]}</span>
            <span class="slide__text">{p.shortDescription[lang]}</span>
          </span>
          <span class="slide__foot">
            <span class="tags">
              {p.tech.slice(0, 3).map((tech: string) => <span class="tag">{tech}</span>)}
            </span>
            <span class="slide__cta">{t('home.open')} →</span>
          </span>
          </span>
          {p.image && (
            <span class="slide__shot">
              <img src={p.image} alt="" width="760" height="560" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            </span>
          )}
        </a>
      );
    })}
  </div>

  <div class="slider__bar shell">
    <div class="slider__nav">
      <a class="btn btn--sm" href={`#slide-${cover.length}`} aria-label={t('home.prevProject')}>←</a>
      <a class="btn btn--sm" href="#slide-2" aria-label={t('home.nextProject')}>→</a>
    </div>
    <div class="slider__ticks">
      {cover.map((p: any, i: number) => (
        <a
          href={`#slide-${i + 1}`}
          class="accent"
          style={`--accent-h: ${p.accentHue}`}
          aria-current={i === 0 ? 'true' : undefined}
          aria-label={p.title[lang]}
        ></a>
      ))}
    </div>
    <span class="meta">{t('home.sliderHint')}</span>
    <div class="counters meta">
      <span><b>{String(n.products).padStart(2, '0')}</b> {t('home.countProducts')}</span>
      <span><b>{String(n.released).padStart(2, '0')}</b> {t('home.countReleased')}</span>
      <span><b class="is-work">{String(n.work).padStart(2, '0')}</b> {t('home.countInProgress')}</span>
      <span><b>{n.done}</b><span class="is-rest">/{n.steps}</span> {t('home.countSteps')}</span>
    </div>
  </div>
</section>

<section class="shell" aria-label={t('home.ledgerTitle')}>
  <div class="row ledger__head meta" aria-hidden="true">
    <span></span>
    <span>{lang === 'en' ? 'Year' : 'Год'}</span>
    <span>{t('projects.product')}</span>
    <span class="ledger__stack">{t('projects.labels.stack')}</span>
    <span class="ledger__steps">{t('projects.steps')}</span>
    <span class="ledger__state">{t('projects.labels.status')}</span>
  </div>
  {projects.map((p: any) => <LedgerRow project={p} lang={lang} variant="ledger" />)}

  <p class="prose home__note">{t('home.lede')}</p>
</section>
