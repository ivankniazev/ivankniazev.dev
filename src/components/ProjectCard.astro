---
import { getLocalizedPath, useTranslations, type Lang } from '../utils/i18n';

interface Props {
  project: any;
  lang: Lang;
  featured?: boolean;
}

const { project, lang, featured = false } = Astro.props;
const t = useTranslations(lang);
const href = getLocalizedPath(`/projects/${project.slug}`, lang);
const status = project.status || 'released';
const initials = project.title.en
  .split(/\s+/)
  .slice(0, 2)
  .map((w: string) => w[0])
  .join('')
  .toUpperCase();
---

<article class:list={['card', { featured }]} style={`--accent: ${project.accent}`}>
  <a href={href} class="card-media" aria-hidden="true" tabindex="-1">
    {project.image ? (
      <img src={project.image} alt="" width="760" height="560" loading="lazy" />
    ) : (
      <span class="card-mono">{initials}</span>
    )}
  </a>
  <div class="card-body">
    <p class="eyebrow">
      <span>{project.domain[lang]}</span>
      <span class="dot" aria-hidden="true"></span>
      <span>{project.year}</span>
      {status !== 'released' && (
        <>
          <span class="dot" aria-hidden="true"></span>
          <span class:list={['state', status]}>{t(`projects.status.${status}`)}</span>
        </>
      )}
    </p>
    <h3 class="card-title"><a href={href}>{project.title[lang]}</a></h3>
    <p class="card-text">{project.shortDescription[lang]}</p>
    <p class="card-tech">{project.tech.join(' · ')}</p>
  </div>
</article>
